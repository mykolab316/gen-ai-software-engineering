# GitHub MCP
# Create a fine-grained PAT at https://github.com/settings/tokens
# Scopes needed: repo (read)
GITHUB_PERSONAL_ACCESS_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Notion MCP
# Create an integration at https://www.notion.so/my-integrations
# Get your Internal Integration Token from the integration settings
NOTION_TOKEN=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

